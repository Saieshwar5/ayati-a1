{
  "name": "ayati-desktop",
  "version": "0.1.0",
  "description": "Secure Electron desktop client for the Ayati daemon",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node ../scripts/clean-dist.mjs . && node scripts/build-assets.mjs && tsc -p tsconfig.node.json && tsc -p tsconfig.renderer.json && vite build",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "electron": "43.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.18"
  }
}
